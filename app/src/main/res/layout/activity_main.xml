<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:padding="14dp"
              android:background="#0B1120"
              android:gravity="center_horizontal">

    <!-- Верхня панель статистики -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#162238"
            android:padding="10dp"
            android:gravity="center_vertical">

        <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#E0F2FE"
                android:textSize="15sp"
                android:textStyle="bold" />

        <TextView
                android:id="@+id/timerText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="#38BDF8"
                android:textSize="15sp"
                android:textStyle="bold" />

        <Button
                android:id="@+id/btnSwitchLang"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#1D4ED8"
                android:textColor="#FFFFFF"
                android:text="@string/btn_language" />
    </LinearLayout>

    <TextView
            android:id="@+id/recordText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="#7DD3FC"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp" />

    <!-- Панель режимів -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

        <Button
                android:id="@+id/btnDifficulty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#1E3A8A"
                android:textColor="#E0F2FE" />

        <Button
                android:id="@+id/btnFog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:backgroundTint="#1E3A8A"
                android:textColor="#E0F2FE" />

        <Button
                android:id="@+id/btnHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#0284C7"
                android:textColor="#FFFFFF"
                android:text="@string/btn_hint" />
    </LinearLayout>

    <!-- Ігрове поле -->
    <com.example.mazeapp.MazeView
            android:id="@+id/mazeView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginVertical="10dp" />

    <!-- Кнопки керування -->
    <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

        <Button
                android:id="@+id/btnUp"
                android:layout_width="76dp"
                android:layout_height="wrap_content"
                android:backgroundTint="#2563EB"
                android:textColor="#FFFFFF"
                android:text="▲" />

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            <Button
                    android:id="@+id/btnLeft"
                    android:layout_width="76dp"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#2563EB"
                    android:textColor="#FFFFFF"
                    android:text="◀" />

            <Button
                    android:id="@+id/btnDown"
                    android:layout_width="76dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:backgroundTint="#2563EB"
                    android:textColor="#FFFFFF"
                    android:text="▼" />

            <Button
                    android:id="@+id/btnRight"
                    android:layout_width="76dp"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#2563EB"
                    android:textColor="#FFFFFF"
                    android:text="▶" />
        </LinearLayout>
    </LinearLayout>

    <Button
            android:id="@+id/btnNewGame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#0369A1"
            android:textColor="#FFFFFF"
            android:text="@string/btn_new_game" />

</LinearLayout>